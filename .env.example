# ==============================================================
# CẤU HÌNH SUPABASE CHO PHÒNG ONLINE REALTIME (TÙY CHỌN)
# ==============================================================
# Ứng dụng hỗ trợ Offline-First: Bạn có thể để trống hoặc cấu hình trực tiếp
# qua giao diện "Cấu hình Supabase" trên điện thoại mà không cần build lại.
# Nếu muốn tự động cấu hình khi deploy lên Vercel/Netlify, hãy điền 2 biến này:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

